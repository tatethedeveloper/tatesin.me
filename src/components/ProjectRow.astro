---
import StatusMark from './StatusMark.astro';
import { statusLabel, type Project } from '../lib/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { title, summary, status, role, stack, year } = project.data;
const href = `/projects/${project.id}/`;
---

<li class={`row row--${status}`}>
  <div class="row-rail">
    <StatusMark status={status} />
  </div>
  <div class="row-body">
    <div class="row-title">
      <a href={href}><span class="h3">{title}</span></a>
      <span class="mono muted">{year}</span>
    </div>
    <p class="measure">{summary}</p>
    <p class="small muted row-meta">
      <span>{statusLabel[status]}</span>
      <span>{role}</span>
      <span>{stack.join(', ')}</span>
    </p>
  </div>
</li>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 14px 1fr;
    column-gap: 16px;
    padding-block: 20px;
  }
  .row-rail {
    padding-top: 6px;
  }
  /* The rule only runs between nodes inside a group, never past the last one. */
  .row:not(:last-child) .row-rail::after {
    content: '';
    position: absolute;
    left: 6.5px;
    top: 26px;
    bottom: -20px;
    border-left: 1px solid var(--line);
  }
  .row--planned:not(:last-child) .row-rail::after {
    border-left-style: dashed;
  }
  .row--building:not(:last-child) .row-rail::after {
    border-left-color: var(--accent);
  }
  .row-body {
    display: grid;
    gap: 6px;
  }
  .row-title {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .row-title a {
    text-decoration: none;
  }
  .row-title a:hover .h3,
  .row-title a:focus-visible .h3 {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    text-decoration-color: var(--accent);
  }
  /* Whole row is the target; the link is the accessible name. */
  .row-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .row-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }
</style>
