---
import { site } from '../lib/site';
import Placeholder from './Placeholder.astro';
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap inner">
    <h2 class="display-lg" id="contact-title"><span class="mask"><span data-rise>Say hello</span></span></h2>
    <div class="ways">
      <div class="way">
        <p class="body-sm body">Email</p>
        {
          site.email ? (
            <p class="email-row">
              <a class="display-sm" href={`mailto:${site.email}`}>{site.email}</a>
              <button class="button secondary" type="button" data-copy={site.email}>
                Copy email
              </button>
            </p>
          ) : (
            <Placeholder label="EMAIL ADDRESS" />
          )
        }
      </div>
      <div class="way">
        <p class="body-sm body">Elsewhere</p>
        <p class="links display-sm">
          {site.github ? <a href={site.github}>GitHub</a> : <Placeholder label="GITHUB URL" />}
          {site.linkedin ? <a href={site.linkedin}>LinkedIn</a> : <Placeholder label="LINKEDIN URL" />}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--hairline);
  }
  .inner {
    display: grid;
    gap: var(--space-xxl);
    padding-block: var(--section);
  }
  .ways {
    display: grid;
    gap: var(--space-xxl);
  }
  .way {
    display: grid;
    gap: var(--space-sm);
    padding-top: var(--space-base);
    border-top: 1px solid var(--hairline);
  }
  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }
  @media (min-width: 1024px) {
    /* The heading and the two ways sit on one line, aligned on their baselines,
       rather than the heading sitting alone above an empty band. */
    .inner {
      grid-template-columns: 4fr 8fr;
      column-gap: var(--space-lg);
      align-items: start;
      row-gap: 0;
    }
    .ways {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-lg);
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  if (btn) {
    const label = btn.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy || '');
        btn.textContent = 'Copied';
        window.setTimeout(() => (btn.textContent = label), 2000);
      } catch {
        btn.textContent = 'Select and copy it';
      }
    });
  }
</script>
