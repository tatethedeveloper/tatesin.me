---
import { site } from '../lib/site';
import Placeholder from './Placeholder.astro';
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap inner">
    <h2 class="display" id="contact-title">Say hello</h2>
    <div class="ways">
      <div class="way">
        <p class="small mist">Email</p>
        {
          site.email ? (
            <p class="email-row">
              <a class="lede" href={`mailto:${site.email}`}>{site.email}</a>
              <button class="button ghost" type="button" data-copy={site.email}>
                Copy email
              </button>
            </p>
          ) : (
            <Placeholder label="EMAIL ADDRESS" />
          )
        }
      </div>
      <div class="way">
        <p class="small mist">Elsewhere</p>
        <p class="links lede">
          {site.github ? <a href={site.github}>GitHub</a> : <Placeholder label="GITHUB URL" />}
          {site.linkedin ? <a href={site.linkedin}>LinkedIn</a> : <Placeholder label="LINKEDIN URL" />}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--panel);
    border-top: 1px solid var(--line);
  }
  .inner {
    display: grid;
    gap: 56px;
    padding-block: var(--section);
  }
  .ways {
    display: grid;
    gap: 40px;
  }
  .way {
    display: grid;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }
  @media (min-width: 1024px) {
    .ways {
      grid-template-columns: 1fr 1fr;
      column-gap: 24px;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  if (btn) {
    const label = btn.textContent;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy || '');
        btn.textContent = 'Copied';
        window.setTimeout(() => (btn.textContent = label), 2000);
      } catch {
        btn.textContent = 'Select and copy it';
      }
    });
  }
</script>
