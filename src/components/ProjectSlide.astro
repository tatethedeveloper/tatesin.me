---
/**
 * One project in the work gallery. The whole slide is the link to the case
 * study: image, status, title, one sentence. Status changes the card itself,
 * not just a word — and it does so in shape, not colour: a solid mark for
 * shipped, an outlined one for building, a dashed one (and a dashed frame)
 * for planned.
 */
import type { Project } from '../lib/projects';
import { statusLabel } from '../lib/projects';
import Placeholder from './Placeholder.astro';

interface Props {
  project: Project;
  index: number;
  total: number;
}
const { project, index, total } = Astro.props;
const { title, summary, status, role, stack, year, placeholder, current, cover } = project.data;
const href = `/projects/${project.id}/`;
---

<li class:list={['slide', status]} data-slide data-index={index} id={`slide-${index}`}>
  <a
    class:list={['face', { 'no-summary': !summary }]}
    href={href}
    aria-describedby={summary ? `slide-sum-${index}` : undefined}
  >
    <span class="visual" data-reveal>
      {
        cover ? (
          <img src={cover.src} width={cover.width} height={cover.height} alt="" loading="lazy" decoding="async" />
        ) : (
          <Placeholder label="PROJECT SCREENSHOT" block />
        )
      }
    </span>

    <span class="status title-sm">
      <span class="mark" aria-hidden="true"></span>
      {statusLabel[status]}{status === 'building' ? ' now' : ''}
      {placeholder && <span class="badge">Placeholder project</span>}
      {current && <span class="badge">Current project</span>}
    </span>

    <span class="display-sm name">{title}</span>
    {summary && <span class="summary body-sm body" id={`slide-sum-${index}`}>{summary}</span>}

    <span class="code meta body">
      <span>{year}</span>
      <span>{role}</span>
      {stack.slice(0, 3).map((s) => <span>{s}</span>)}
    </span>

    <span class="go body-sm">
      <span class="go-label">Open the project</span>
      <span class="count code body">{String(index + 1).padStart(2, '0')}/{String(total).padStart(2, '0')}</span>
    </span>
  </a>
</li>

<style>
  .slide {
    /* Width comes from the track, which needs it to size the space after the
       last slide. */
    flex: 0 0 var(--slide, min(84vw, 440px));
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .face {
    display: grid;
    /* The last track is the one that stretches, so "Open the project" stays on
       the bottom edge whatever the slide holds above it. */
    grid-template-rows: auto auto auto auto auto 1fr;
    gap: 14px;
    height: 100%;
    padding: var(--space-base) var(--space-base) var(--space-md);
    border: 1px solid var(--hairline);
    border-radius: var(--rounded-lg);
    background: var(--surface-card);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease-out),
      transform 260ms var(--ease-out);
  }
  /* A project with no summary yet is one row shorter. */
  .face.no-summary {
    grid-template-rows: auto auto auto auto 1fr;
  }
  /* Planned: an intention, not a surface. Dashed frame, canvas showing through. */
  .planned .face {
    background: transparent;
    border-style: dashed;
    border-color: var(--hairline-strong);
  }
  @media (hover: hover) and (pointer: fine) {
    .face:hover {
      border-color: var(--ink);
      transform: translateY(-4px);
    }
    .face:hover .go-label {
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }
    .face:hover .visual :global(img) {
      transform: scale(1.03);
    }
  }
  .visual {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: var(--rounded-md);
    background: var(--canvas-soft);
  }
  .visual :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out);
  }
  .visual :global(.ph) {
    height: 100%;
  }
  /* With script and motion the image uncovers from the bottom on arrival. */
  :global(html.js:not(.reduced)) .visual {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 800ms var(--ease-out);
  }
  :global(html.js:not(.reduced)) .visual.in {
    clip-path: inset(0 0 0 0);
  }

  .status {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    color: var(--ink);
  }
  .mark {
    width: 10px;
    height: 10px;
    flex: none;
    border: 1.5px solid var(--ink);
  }
  .shipped .mark {
    background: var(--ink);
  }
  .planned .mark {
    border-style: dashed;
  }
  .planned .status {
    color: var(--body);
  }

  .name {
    display: block;
    color: var(--ink);
  }
  .planned .name {
    color: var(--body);
  }
  .summary {
    display: block;
    max-width: 42ch;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .go {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-base);
    padding-top: var(--space-xs);
    border-top: 1px solid var(--hairline);
    color: var(--ink);
    font-weight: 500;
  }
</style>
