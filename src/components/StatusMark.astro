---
/**
 * The status node. Three genuinely different drawings, not three colours:
 * building = filled accent, planned = outlined ink, shipped = filled ink.
 * Decorative; the status word is rendered as text by the caller.
 */
import type { Status } from '../lib/projects';
interface Props {
  status: Status;
}
const { status } = Astro.props;
---

<svg class={`mark mark--${status}`} width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
  <circle cx="7" cy="7" r="5.5"></circle>
</svg>

<style>
  .mark {
    flex: none;
  }
  .mark circle {
    stroke-width: 1.5;
  }
  .mark--building circle {
    fill: var(--accent);
    stroke: var(--accent);
  }
  .mark--planned circle {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-dasharray: 3 2.2;
  }
  .mark--shipped circle {
    fill: var(--ink);
    stroke: var(--ink);
  }
</style>
