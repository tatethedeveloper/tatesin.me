---
/**
 * The one way missing content is shown. A dashed frame in the error colour
 * with the label in mono, so it cannot be mistaken for real content: a fact
 * that is missing is a defect in the page and should look like one. `block`
 * makes it fill a slot (an image frame, a paragraph); inline is for a word
 * or a link.
 */
interface Props {
  label: string;
  block?: boolean;
  /** Aspect ratio for block slots, e.g. "4 / 3". */
  ratio?: string;
  class?: string;
}
const { label, block = false, ratio, class: cls } = Astro.props;
---

{
  block ? (
    <div class:list={['ph', 'ph-block', cls]} style={ratio ? `aspect-ratio: ${ratio}` : undefined} role="note">
      <span class="code">[ADD: {label}]</span>
    </div>
  ) : (
    <span class:list={['ph', 'ph-inline', 'code', cls]} role="note">[ADD: {label}]</span>
  )
}

<style>
  .ph {
    color: var(--error);
    border: 1px dashed var(--error);
    border-radius: var(--rounded-md);
  }
  .ph-inline {
    display: inline-block;
    padding: 2px 8px;
    vertical-align: baseline;
  }
  .ph-block {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 80px;
    padding: var(--space-lg);
    text-align: center;
    background: repeating-linear-gradient(
      -45deg,
      transparent 0 14px,
      color-mix(in srgb, var(--error) 5%, transparent) 14px 15px
    );
  }
</style>
