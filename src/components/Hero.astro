---
import { site } from '../lib/site';
import Structure from './Structure.astro';
import DotBloom from './DotBloom.astro';
---

<section class="hero" id="hero" aria-labelledby="hero-title">
  <DotBloom gap={30} speed={1} />

  <div class="wrap frame">
    <h1 class="display" id="hero-title">
      <span class="mask"><span class="line">Tate</span></span>
      <span class="mask"><span class="line">Sinclair</span></span>
    </h1>

    <p class="lede intro role">{site.role},<br />{site.location}</p>

    <p class="lede intro pitch">Early career. Building in the open, and showing the work while it is still work.</p>

    <a class="button intro cta" href="/#work">See what I'm building</a>

    <div class="scene">
      <Structure />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100dvh;
    display: grid;
    align-items: stretch;
    padding-top: var(--nav-h);
    overflow: clip;
  }
  .frame {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: end;
    gap: 28px;
    padding-bottom: clamp(32px, 5vh, 56px);
  }
  .display {
    position: relative;
    z-index: 1;
  }
  .role,
  .pitch {
    color: var(--mist);
  }
  .cta {
    justify-self: start;
  }
  .scene {
    position: relative;
  }

  @media (min-width: 1024px) {
    /* The three rows are spread over the viewport height rather than bunched
       at the bottom: the role sits under the nav, the name in the middle band,
       the pitch and the button on the floor. Nothing is left hanging empty. */
    .frame {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto minmax(0, 1fr) auto;
      column-gap: 24px;
      align-content: stretch;
      row-gap: 0;
      padding-top: clamp(24px, 5vh, 56px);
      padding-bottom: clamp(40px, 6vh, 72px);
    }
    /* Three rows on the left, the structure holding the right for all of
       them. No placement overlaps another, so nothing can collide. */
    .role {
      grid-column: 1 / span 4;
      grid-row: 1;
      align-self: start;
    }
    .display {
      grid-column: 1 / span 6;
      grid-row: 2;
      align-self: center;
    }
    .pitch {
      grid-column: 1 / span 4;
      grid-row: 3;
      align-self: end;
      max-width: 34ch;
    }
    .cta {
      grid-column: 5 / span 2;
      grid-row: 3;
      align-self: end;
    }
    .scene {
      grid-column: 7 / -1;
      grid-row: 1 / span 3;
      align-self: stretch;
      justify-self: stretch;
      width: 100%;
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto;
      min-height: 0;
    }
  }

  @media (max-width: 1023px) {
    .frame {
      align-content: start;
      padding-top: 24px;
    }
    /* Two rows so the caption sits under the drawing instead of overflowing
       the fixed height and landing on the pitch below. */
    .scene {
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto;
      min-height: 46vh;
      order: 3;
    }
    .role {
      order: 1;
    }
    .display {
      order: 2;
    }
    .pitch {
      order: 4;
    }
    .cta {
      order: 5;
    }
  }

  .mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
  }
  .line {
    display: block;
    animation: rise 1.1s var(--ease-out) both;
  }
  .mask:nth-child(2) .line {
    animation-delay: 0.09s;
  }
  .intro {
    animation: settle 0.8s var(--ease-out) both;
  }
  .role.intro {
    animation-delay: 0.45s;
  }
  .pitch.intro {
    animation-delay: 0.6s;
  }
  .cta.intro {
    animation-delay: 0.7s;
  }
  @keyframes rise {
    from {
      transform: translateY(110%);
    }
    to {
      transform: none;
    }
  }
  @keyframes settle {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
