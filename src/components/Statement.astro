---
/**
 * One long line of display text between the hero and the work. Each word is
 * wrapped so the motion script can bring them up to ink in reading order as
 * the visitor scrolls; without script every word is already ink.
 * TODO(tate): this is written in your voice from the brief. Edit freely.
 */
const text =
  'I would rather show the work while it is being built than wait until it looks finished. What is here is real, in progress, and marked as such.';
const words = text.split(' ');
---

<section class="statement wrap" aria-label="Statement">
  <p class="display-md" data-words>
    {words.map((w) => <span class="w">{w} </span>)}
  </p>
</section>

<style>
  .statement {
    padding-block: var(--section);
  }
  .display-md {
    max-width: 40ch;
  }
  .w {
    display: inline;
    color: var(--ink);
    transition: color 200ms var(--ease-out);
  }
  /* With script and motion allowed, words start muted and come up to ink on
     scroll. Muted is 3.6:1 on the canvas, which clears 3:1 at this size. */
  :global(html.js:not(.reduced)) .w {
    color: var(--muted);
  }
  :global(html.js:not(.reduced)) .w.on {
    color: var(--ink);
  }
</style>
