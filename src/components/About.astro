---
import { site } from '../lib/site';
import { about } from '../lib/about';
import Placeholder from './Placeholder.astro';
---

<section class="about wrap" id="about" aria-labelledby="about-title">
  <h2 class="display-lg" id="about-title"><span class="mask"><span data-rise>About</span></span></h2>
  <div class="cols">
    <div class="prose">
      {
        about.map((b) =>
          'text' in b ? <p class="display-sm body">{b.text}</p> : <Placeholder label={b.placeholder} block />,
        )
      }
    </div>
    <dl class="facts body-sm">
      <div>
        <dt class="body">Role</dt>
        <dd>{site.role}</dd>
      </div>
      <div>
        <dt class="body">Based in</dt>
        <dd>{site.location}</dd>
      </div>
      <div>
        <dt class="body">Stage</dt>
        <dd>Early career</dd>
      </div>
      {
        site.repo && (
          <div>
            <dt class="body">This site</dt>
            <dd>
              <a href={site.repo}>Built in the open</a>
            </dd>
          </div>
        )
      }
    </dl>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section);
    display: grid;
    gap: var(--space-xl);
  }
  .cols {
    display: grid;
    gap: var(--space-xxl);
  }
  .prose {
    display: grid;
    gap: var(--space-lg);
    max-width: var(--measure);
  }
  .facts {
    display: grid;
    gap: var(--space-base);
    align-content: start;
  }
  .facts div {
    display: grid;
    gap: 2px;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--hairline);
  }
  .facts dd {
    font-weight: 500;
  }
  @media (min-width: 1024px) {
    /* The heading sits in the left column beside the prose rather than above
       it, so the width the display type leaves over is used. */
    .about {
      grid-template-columns: 4fr 8fr;
      column-gap: var(--space-lg);
      align-items: start;
      row-gap: 0;
    }
    .cols {
      grid-template-columns: 8fr 4fr;
      column-gap: var(--space-xxl);
    }
  }
</style>
