---
import { site } from '../lib/site';
import { about } from '../lib/about';
import Placeholder from './Placeholder.astro';
---

<section class="about wrap" id="about" aria-labelledby="about-title">
  <h2 class="display" id="about-title"><span class="mask"><span data-rise>About</span></span></h2>
  <div class="cols">
    <div class="prose">
      {
        about.map((b) =>
          'text' in b ? <p class="lede measure">{b.text}</p> : <Placeholder label={b.placeholder} block />,
        )
      }
    </div>
    <dl class="facts small">
      <div>
        <dt class="mist">Role</dt>
        <dd>{site.role}</dd>
      </div>
      <div>
        <dt class="mist">Based in</dt>
        <dd>{site.location}</dd>
      </div>
      <div>
        <dt class="mist">Stage</dt>
        <dd>Early career</dd>
      </div>
      <div>
        <dt class="mist">This site</dt>
        <dd><a href={site.repo}>Built in the open</a></dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .about {
    padding-block: var(--section);
    display: grid;
    gap: 32px;
  }
  .cols {
    display: grid;
    gap: 40px;
  }
  .prose {
    display: grid;
    gap: 24px;
  }
  .facts {
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .facts div {
    display: grid;
    gap: 2px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 1024px) {
    /* The heading sits in the left column beside the prose rather than above
       it, so the width the display type leaves over is used. */
    .about {
      grid-template-columns: 4fr 8fr;
      column-gap: 24px;
      align-items: start;
      row-gap: 0;
    }
    .cols {
      grid-template-columns: 8fr 4fr;
      column-gap: 40px;
    }
  }
</style>
