---
/**
 * What Tate works in and what he is learning, as two large lists. Grouped by
 * honest proficiency; no bars, no logos, no ratings. Empty groups render a
 * placeholder rather than a guess.
 */
import { skills } from '../lib/skills';
import Placeholder from './Placeholder.astro';
---

<section class="caps wrap" aria-labelledby="caps-title">
  <h2 class="display-lg" id="caps-title">Where I am with tools</h2>
  <div class="groups">
    {
      skills.map((g) => (
        <div class="group">
          <h3 class="title-md">{g.heading}</h3>
          {g.items.length ? (
            <ul class="items display-sm">
              {g.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : (
            <Placeholder label={g.placeholder} block />
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  .caps {
    padding-block: var(--section);
    display: grid;
    gap: var(--space-xl);
  }
  .groups {
    display: grid;
    gap: var(--space-xl);
  }
  .group {
    display: grid;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--hairline);
  }
  .items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15em 0.5em;
    color: var(--body);
  }
  .items li:not(:last-child)::after {
    content: ',';
  }
  @media (min-width: 1024px) {
    .caps {
      grid-template-columns: 4fr 8fr;
      column-gap: var(--space-lg);
    }
    .groups {
      grid-column: 2;
    }
    .group {
      grid-template-columns: 2fr 7fr;
      column-gap: var(--space-lg);
      align-items: start;
    }
  }
</style>
