---
/**
 * A dot-matrix bloom behind a section: faint halftone grid, with patches of
 * light drifting through it. Decoration, so it is hidden from assistive
 * technology and takes no pointer input; the section reads exactly the same
 * with it absent, which is what happens when script does not run.
 *
 * Place inside a positioned element. Colour comes from `--dot`, so it stays
 * with the rest of the palette.
 */
interface Props {
  /** Distance between dots in CSS pixels. Larger is sparser and cheaper. */
  gap?: number;
  /** Drift rate; 1 is the reference speed. */
  speed?: number;
  class?: string;
}
const { gap = 26, speed = 1, class: cls } = Astro.props;
---

<div class:list={['bloom', cls]} data-bloom data-gap={gap} data-speed={speed} aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .bloom {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    /* The dots are drawn in this colour. */
    color: var(--mist);
    /* Fades out towards the edges, so the field never ends on a hard line
       against the section below it. */
    -webkit-mask-image: radial-gradient(125% 105% at 50% 45%, #000 30%, transparent 100%);
    mask-image: radial-gradient(125% 105% at 50% 45%, #000 30%, transparent 100%);
  }
  .bloom canvas {
    display: block;
  }
</style>

<script>
  import { dotBloom } from '../scripts/dot-bloom';

  document.querySelectorAll<HTMLElement>('[data-bloom]').forEach((host) => {
    dotBloom(host, {
      gap: Number(host.dataset.gap) || undefined,
      speed: Number(host.dataset.speed) || undefined,
    });
  });
</script>
