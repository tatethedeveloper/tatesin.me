---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import { getProjects, statusLabel } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, status, role, stack, year, repo, demo, placeholder, cover } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary} path={`/projects/${project.id}/`}>
  <article class:list={['study', status]}>
    <header class="wrap head">
      <p class="body-sm"><a href="/#work">All work</a></p>
      <p class="status title-sm">
        <span class="mark" aria-hidden="true"></span>
        {statusLabel[status]}{status === 'building' ? ' now' : ''}
        {placeholder && <span class="badge">Placeholder project</span>}
      </p>
      <h1 class="display-lg">{title}</h1>
      <p class="display-sm measure body">{summary}</p>
    </header>

    <div class="wrap visual" aria-hidden={cover ? undefined : 'true'}>
      {cover ? <img src={cover.src} width={cover.width} height={cover.height} alt="" /> : <Placeholder label="PROJECT SCREENSHOT OR RECORDING" block ratio="16 / 9" />}
    </div>

    <div class="wrap study-body">
      <dl class="facts body-sm">
        <div>
          <dt class="body">Role</dt>
          <dd>{role}</dd>
        </div>
        <div>
          <dt class="body">Year</dt>
          <dd class="code">{year}</dd>
        </div>
        <div>
          <dt class="body">Stack</dt>
          <dd class="code stack">{stack.map((s) => <span>{s}</span>)}</dd>
        </div>
        {
          (repo || demo) && (
            <div>
              <dt class="body">Links</dt>
              <dd class="links">
                {repo && <a href={repo}>Repository</a>}
                {demo && <a href={demo}>Demo</a>}
              </dd>
            </div>
          )
        }
      </dl>

      <div class="prose measure">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .head {
    display: grid;
    gap: var(--space-lg);
    padding-top: calc(var(--nav-h) + var(--section));
    padding-bottom: var(--space-xxl);
  }
  .status {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .mark {
    width: 10px;
    height: 10px;
    border: 1.5px solid var(--ink);
  }
  .shipped .mark {
    background: var(--ink);
  }
  .planned .mark {
    border-style: dashed;
  }
  .planned .status {
    color: var(--body);
  }
  .visual :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--rounded-lg);
    border: 1px solid var(--hairline);
  }
  .study-body {
    display: grid;
    gap: var(--space-xxl);
    padding-block: var(--space-xxl) var(--section);
  }
  .facts {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }
  .facts div {
    display: grid;
    gap: var(--space-xxs);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--hairline);
  }
  .facts dd {
    font-weight: 500;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .links {
    display: flex;
    gap: var(--space-base);
  }
  .prose {
    color: var(--body);
  }
  .prose :global(h2) {
    font-size: 26px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.0125em;
    color: var(--ink);
    margin-top: var(--space-xxl);
    margin-bottom: var(--space-base);
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(p + p) {
    margin-top: 1em;
  }
  .prose :global(ul) {
    list-style: disc;
    padding-left: 1.2em;
  }
  .prose :global(img) {
    border: 1px solid var(--hairline);
    border-radius: var(--rounded-lg);
  }
  .prose :global(code) {
    padding: 1px 5px;
    border-radius: var(--rounded-xs);
    background: var(--surface-card);
    border: 1px solid var(--hairline);
  }
  @media (min-width: 1024px) {
    .study-body {
      grid-template-columns: 3fr 1fr 8fr;
    }
    .prose {
      grid-column: 3;
    }
  }
</style>
