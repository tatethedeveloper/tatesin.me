---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StatusMark from '../../components/StatusMark.astro';
import { getProjects, statusLabel } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, status, role, stack, year, repo, demo } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary} path={`/projects/${project.id}/`}>
  <article class="wrap section">
    <p class="small"><a href="/#work">All work</a></p>
    <header class="head">
      <h1 class="display">{title}</h1>
      <p class="measure lede">{summary}</p>
    </header>

    <dl class="facts small">
      <div>
        <dt class="muted">Status</dt>
        <dd class="fact-status"><StatusMark status={status} /> {statusLabel[status]}</dd>
      </div>
      <div>
        <dt class="muted">Role</dt>
        <dd>{role}</dd>
      </div>
      <div>
        <dt class="muted">Year</dt>
        <dd class="mono">{year}</dd>
      </div>
      <div>
        <dt class="muted">Stack</dt>
        <dd>{stack.join(', ')}</dd>
      </div>
      {
        (repo || demo) && (
          <div>
            <dt class="muted">Links</dt>
            <dd class="links">
              {repo && <a href={repo}>Repository</a>}
              {demo && <a href={demo}>Demo</a>}
            </dd>
          </div>
        )
      }
    </dl>

    <div class="prose measure">
      <Content />
    </div>
  </article>
</Base>

<style>
  .head {
    display: grid;
    gap: 16px;
    margin-top: 24px;
  }
  .lede {
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--muted);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, max-content));
    gap: 16px 40px;
    margin-block: 40px;
    padding-block: 20px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    margin-bottom: 2px;
  }
  .fact-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .links {
    display: flex;
    gap: 16px;
  }
  .prose :global(h2) {
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: 1.3;
    margin-top: 40px;
    margin-bottom: 12px;
  }
  .prose :global(p + p) {
    margin-top: 1em;
  }
  .prose :global(ul) {
    list-style: disc;
    padding-left: 1.2em;
  }
  .prose :global(img) {
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
</style>
