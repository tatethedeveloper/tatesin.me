---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import { getProjects, statusLabel } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, status, role, stack, year, repo, demo, placeholder, cover } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary} path={`/projects/${project.id}/`}>
  <article class:list={['study', status]}>
    <header class="wrap head">
      <p class="small"><a href="/#work">All work</a></p>
      <p class="status">
        <span class="mark" aria-hidden="true"></span>
        {statusLabel[status]}{status === 'building' ? ' now' : ''}
        {placeholder && <span class="ph-mark mono">Placeholder project</span>}
      </p>
      <h1 class="display">{title}</h1>
      <p class="lede measure mist">{summary}</p>
    </header>

    <div class="wrap visual" aria-hidden={cover ? undefined : 'true'}>
      {cover ? <img src={cover.src} width={cover.width} height={cover.height} alt="" /> : <Placeholder label="PROJECT SCREENSHOT OR RECORDING" block ratio="16 / 9" />}
    </div>

    <div class="wrap body">
      <dl class="facts small">
        <div>
          <dt class="mist">Role</dt>
          <dd>{role}</dd>
        </div>
        <div>
          <dt class="mist">Year</dt>
          <dd class="mono">{year}</dd>
        </div>
        <div>
          <dt class="mist">Stack</dt>
          <dd class="mono stack">{stack.map((s) => <span>{s}</span>)}</dd>
        </div>
        {
          (repo || demo) && (
            <div>
              <dt class="mist">Links</dt>
              <dd class="links">
                {repo && <a href={repo}>Repository</a>}
                {demo && <a href={demo}>Demo</a>}
              </dd>
            </div>
          )
        }
      </dl>

      <div class="prose measure">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .head {
    display: grid;
    gap: 24px;
    padding-top: calc(var(--nav-h) + clamp(40px, 8vw, 96px));
    padding-bottom: clamp(40px, 6vw, 72px);
  }
  .status {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 500;
  }
  .mark {
    width: 12px;
    height: 12px;
    border: 1px solid var(--bone);
  }
  .building .mark {
    background: var(--pulse);
    border-color: var(--pulse);
  }
  .building .status {
    color: var(--pulse);
  }
  .shipped .mark {
    background: var(--bone);
  }
  .planned .mark {
    border-style: dashed;
    border-color: var(--mist);
  }
  .planned .status {
    color: var(--mist);
  }
  .ph-mark {
    margin-left: 12px;
    padding: 2px 8px;
    border: 1px dashed var(--pulse);
    color: var(--pulse);
    font-weight: 400;
  }
  .visual :global(img) {
    width: 100%;
    height: auto;
  }
  .body {
    display: grid;
    gap: 48px;
    padding-block: clamp(48px, 8vw, 96px) var(--section);
  }
  .facts {
    display: grid;
    gap: 20px;
    align-content: start;
  }
  .facts div {
    display: grid;
    gap: 4px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .links {
    display: flex;
    gap: 16px;
  }
  .prose :global(h2) {
    font-size: var(--text-h2);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin-top: 56px;
    margin-bottom: 16px;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(p) {
    color: var(--mist);
  }
  .prose :global(p + p) {
    margin-top: 1em;
  }
  .prose :global(ul) {
    list-style: disc;
    padding-left: 1.2em;
    color: var(--mist);
  }
  .prose :global(img) {
    border: 1px solid var(--line);
  }
  @media (min-width: 1024px) {
    .body {
      grid-template-columns: 3fr 1fr 8fr;
    }
    .prose {
      grid-column: 3;
    }
  }
</style>
