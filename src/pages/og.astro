---
/**
 * Source for the Open Graph image. Screenshot at 1200x630 into public/og.png
 * (see docs in CLAUDE.md). Excluded from the sitemap and marked noindex.
 */
import '../styles/global.css';
import { site } from '../lib/site';
import { getCommits } from '../lib/git';
import { grow, bounds, project, uniqueNodes } from '../lib/lattice';

const commits = getCommits();
const struts = grow(commits.map((c) => c.hash));
const { centre } = bounds(struts);
const nodes = uniqueNodes(struts);
const pts = struts.flatMap((s) => [project(s.a, centre), project(s.b, centre)]);
const pad = 0.8;
const minX = Math.min(...pts.map((p) => p[0])) - pad;
const minY = Math.min(...pts.map((p) => p[1])) - pad;
const w = Math.max(...pts.map((p) => p[0])) - minX + pad;
const h = Math.max(...pts.map((p) => p[1])) - minY + pad;
const side = Math.max(w, h);
const viewBox = `${minX - (side - w) / 2} ${minY - (side - h) / 2} ${side} ${side}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>OG image source</title>
    <style>
      html,
      body {
        width: 1200px;
        height: 630px;
        overflow: hidden;
      }
      .og {
        width: 1200px;
        height: 630px;
        display: grid;
        grid-template-columns: 1fr 480px;
        align-items: center;
        padding: 0 80px;
        gap: 40px;
      }
      .name {
        font-size: 84px;
        font-weight: 600;
        line-height: 1;
        letter-spacing: -0.02em;
      }
      .line {
        margin-top: 24px;
        font-size: 30px;
        line-height: 1.3;
        max-width: 18ch;
      }
      .url {
        margin-top: 48px;
        font-size: 24px;
      }
      svg {
        width: 480px;
        height: 480px;
      }
    </style>
  </head>
  <body>
    <div class="og">
      <div>
        <div class="name">{site.name}</div>
        <div class="line">{site.role} in {site.location}. Early career, building in the open.</div>
        <div class="url mono">tatesin.me</div>
      </div>
      <svg viewBox={viewBox} aria-hidden="true">
        <g fill="none" stroke="var(--ink)" stroke-width="0.035" stroke-linecap="round">
          {
            struts.map((s, i) => {
              const [x1, y1] = project(s.a, centre);
              const [x2, y2] = project(s.b, centre);
              return (
                <line x1={x1} y1={y1} x2={x2} y2={y2} stroke={i === struts.length - 1 ? 'var(--accent)' : undefined} />
              );
            })
          }
        </g>
        <g fill="var(--ink)">
          {
            nodes.map((p) => {
              const [x, y] = project(p, centre);
              return <rect x={x - 0.04} y={y - 0.04} width="0.08" height="0.08" />;
            })
          }
        </g>
      </svg>
    </div>
  </body>
</html>
