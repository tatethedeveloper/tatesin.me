---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="That page doesn't exist." path="/404/">
  <section class="wrap section" style="padding-top: calc(var(--nav-h) + var(--section))">
    <h1 class="display-lg">Not found</h1>
    <p class="measure display-sm body">
      There's nothing at this address. It may have moved while I was rebuilding, or the link was
      wrong.
    </p>
    <ul class="options">
      <li><a href="/">Start at the home page</a></li>
      <li><a href="/#work">See what I'm building</a></li>
    </ul>
  </section>
</Base>

<style>
  .display-sm {
    margin-top: var(--space-base);
  }
  .options {
    margin-top: var(--space-xl);
    display: grid;
    gap: var(--space-xs);
  }
</style>
